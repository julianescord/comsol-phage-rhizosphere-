# --- Secretos: NUNCA versionar ---------------------------------------
.env
*.key

# --- Entornos virtuales de Python ------------------------------------
venv/
mcp_server/venv/
__pycache__/
*.py[cod]

# --- Artefactos generados por COMSOL ---------------------------------
# Los modelos .mph y sus salidas son REPRODUCIBLES a partir de scripts/.
# La fuente de verdad es el codigo, no el binario.
#   models/etapa1_difusion_pura.mph  <- scripts/build_etapa1.py
#   models/etapa1_validacion.{csv,png} <- scripts/validate_etapa1.py
models/*
!models/.gitkeep

# Corridas batch de prueba y sus recovery/status
test_batch/
*.mph.recovery
*.mph.status

# --- Configuracion local del IDE / Claude Code -----------------------
.claude/settings.local.json

# Crash logs de la JVM (COMSOL/JPype)
hs_err_pid*.log

# --- Copias derivadas por herramientas externas (doc2md, etc.) -------
# Conversion automatica de un HTML/informe a Markdown, generada por una
# herramienta externa al repo (no un script propio). Se regenera bajo
# demanda a partir de la fuente real (docs/summary/resumen.html); no se
# versiona para que no quede desincronizada en silencio.
docs/summary/Markdown/
Markdown/analisis_nano.md
